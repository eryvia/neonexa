;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="neonexa"
run/main_scene="uid://dn0d1brp825vr"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://Utilities/SignalBus.gd"
Global="*res://Utilities/Global.gd"
InteractiveManager="*res://Utilities/InteractiveManager.tscn"
DialogueManager="*res://Utilities/DialogueManager.gd"

[display]

